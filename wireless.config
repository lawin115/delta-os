config wifi-device 'radio0'
	option type 'mac80211'
	option phy 'phy0'
	option path 'platform/ahb/18100000.wmac'
	option channel 'auto'
	option hwmode '11a'
	option htmode 'HT40'
	option country '00'
	option noscan '1'
	option distance '10000'
	option ani '1'
	option disabled '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'wan'
	option mode 'sta'
	option ifname 'wlan0'
	option ssid 'delta'
	option primary_ssid 'delta'
	option encryption 'psk-mixed'
	option key '12345678'
	option primary_key '12345678'
	option backup_ssid 'deta'
	option backup_key ''
	option auto_failover '0'
	option scan_ssid '1'
